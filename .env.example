# ─── API ─────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./support.db

# Telegram Bot token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Whitelist operator Telegram user IDs (comma-separated)
OPERATOR_ALLOWLIST=123456789,987654321

# HMAC secret = bot token (used to validate initData from Mini App)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# API server
API_HOST=0.0.0.0
API_PORT=8000

# ─── BOT ─────────────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here

# Base URL of the API (bot uses it internally)
API_BASE_URL=http://localhost:8000

# ─── WEB (Mini App) ──────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
