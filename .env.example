# ─── API ─────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./support.db

# Telegram Bot token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Whitelist operator Telegram user IDs (comma-separated)
OPERATOR_ALLOWLIST=123456789,987654321

# URL of the bot's callback server (for operator → user delivery)
BOT_CALLBACK_URL=http://localhost:8001/send

# ─── BOT ─────────────────────────────────────────────────────────────────────
# BOT_TOKEN is shared with the API section above

# Base URL of the API (bot uses it internally)
API_BASE_URL=http://localhost:8000

# ─── WEB (Mini App) ──────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
